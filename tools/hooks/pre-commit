#!/bin/sh
# pre-commit — block any commit that ships the Google "API key required" base-map surface, or a
# literal \uXXXX escape leak, on any map. Wired via: git config core.hooksPath tools/hooks
# (run once; see CLAUDE.md). Mirrors the npm-test gates so the guarantee holds even without npm.
root="$(git rev-parse --show-toplevel)"
python3 "$root/tools/check-google.py"  || { echo "pre-commit: BLOCKED — Google 'API key' surface on a map (tools/strip-google-basemap.py to fix)"; exit 1; }
python3 "$root/tools/check-escapes.py" || { echo "pre-commit: BLOCKED — literal escape leaked into visible HTML"; exit 1; }
exit 0
