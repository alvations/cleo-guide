{
  "name": "field-guide-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Test and validation harness for the field guide",
  "scripts": {
    "test": "node run-tests.js",
    "test:serial": "node test.js && node test-singapore.js && python3 check-escapes.py && python3 check-google.py && python3 test-geo-merge.py && node beta/test-beta.js && node beta/test-hubs.js && node beta/qa/test-contract.js && node beta/imagery/test-imagery.js && node beta/test-fe-a.js && node beta/test-views.js && node beta/qa/test-honesty.js && node beta/test-i18n.js",
    "test:singapore": "node test-singapore.js",
    "check:escapes": "python3 check-escapes.py",
    "check:google": "python3 check-google.py",
    "validate": "node validate.js",
    "research": "node research.js",
    "qa": "node qa-site.js --shots",
    "beta": "node beta/build.js",
    "beta:check": "node beta/build.js --check",
    "beta:og": "node beta/og.js",
    "beta:offline": "node beta/offline-check.js",
    "test:beta": "node beta/test-beta.js",
    "beta:metrics": "node beta/metrics.js",
    "beta:metrics:all": "node beta/metrics.js --all",
    "qa:beta": "node qa-site.js --only beta/ --shots",
    "beta:qa:w2": "node beta/qa/w2.js",
    "beta:qa:views": "node beta/qa/views.js",
    "beta:probe:fe-a:w8": "node beta/w8-fe-a-probe.js",
    "beta:probe:fe-a": "node beta/w7-fe-a-probe.js",
    "beta:qa:w8p": "node beta/qa/w8-platform.js",
    "beta:perf": "node beta/qa/perf.js"
  },
  "dependencies": {
    "jsdom": "^24.0.0",
    "leaflet": "^1.9.4",
    "terser": "5.36.0"
  }
}
