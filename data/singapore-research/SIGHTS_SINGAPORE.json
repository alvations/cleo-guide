    {"t":1,"a":"SGE","n":"Koon Seng Road Peranakan Shophouses (Joo Chiat/Katong)","address":"Koon Seng Road, Joo Chiat","k":"Heritage","w":"Singapore's most photographed row of pastel Peranakan shophouses (1920s) in the Katong-Joo Chiat conservation area.","sources":[["ROOTS","https://www.roots.gov.sg/stories-landing/stories/copy-of-street-corner-heritage-galleries-katong-joo-chiat"],["WIKI","https://en.wikipedia.org/wiki/Joo_Chiat_Road"]]},
    {"t":1,"a":"SGE","n":"Jewel Changi Airport & HSBC Rain Vortex","address":"78 Airport Boulevard, Changi Airport","k":"Landmark","w":"Glass-domed nature-and-retail complex housing the world's tallest indoor waterfall (40 m) and Shiseido Forest Valley.","sources":[["CHANGI","https://www.changiairport.com/en/at-changi/jewel-changi-airport.html"],["WIKI","https://en.wikipedia.org/wiki/Jewel_Changi_Airport"]]},
    {"t":2,"a":"SGE","n":"Changi Chapel & Museum","address":"1000 Upper Changi Road North, Changi","k":"Museum","w":"NHB museum commemorating WWII POWs interned at Changi, with a replica of the Changi Chapel.","sources":[["NHB","https://www.nhb.gov.sg/changichapelmuseum/"],["WIKI","https://en.wikipedia.org/wiki/Changi_Chapel_and_Museum"]]},
    {"t":2,"a":"SGE","n":"East Coast Park","address":"East Coast Park Service Road, Marine Parade","k":"Park","w":"Singapore's largest seaside park; 15 km of coastline for cycling, seafood and the sea breeze.","sources":[["NPARKS","https://www.nparks.gov.sg/visit/parks/park-detail/east-coast-park"],["VISITSG","https://www.visitsingapore.com/see-do-singapore/nature-wildlife/parks-gardens/east-coast-park/"]]},
    {"t":3,"a":"SGE","n":"Geylang Serai Market & Malay Heritage","address":"1 Geylang Serai","k":"Heritage","w":"The cultural heart of the Malay-Muslim community; a bustling wet market and Ramadan bazaar hub.","sources":[["ROOTS","https://www.roots.gov.sg/places/places-landing/trails/geylang-serai-heritage-trail"],["VISITSG","https://www.visitsingapore.com/see-do-singapore/culture-heritage/ethnic-quarters/"]]},
    {"t":1,"a":"SGWN","n":"Singapore Botanic Gardens","address":"1 Cluny Road, Bukit Timah","k":"Garden","w":"Singapore's first UNESCO World Heritage Site (2015); a 160-year-old tropical garden with the National Orchid Garden.","sources":[["UNESCO","https://whc.unesco.org/en/list/1483/"],["NPARKS","https://www.nparks.gov.sg/sbg/about/singapore-s-first-unesco-world-heritage-site"]]},
    {"t":1,"a":"SGWN","n":"Southern Ridges & Henderson Waves","address":"Henderson Road, Mount Faber / Telok Blangah","k":"Nature","w":"10 km of ridge-top trails linking Mount Faber, Telok Blangah & Kent Ridge, crossing the wave-form Henderson Waves, Singapore's highest pedestrian bridge.","sources":[["NPARKS","https://www.nparks.gov.sg/visit/parks/park-detail/southern-ridges"],["WIKI","https://en.wikipedia.org/wiki/Henderson_Waves"]]},
