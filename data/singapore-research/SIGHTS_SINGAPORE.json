    {"t":2,"a":"SGC","n":"Sri Veeramakaliamman Temple","address":"141 Serangoon Road, Little India","k":"Temple","w":"Little India's landmark Hindu temple to the goddess Kali, founded by Tamil lime-kiln workers (1855).","sources":[["ROOTS","https://www.roots.gov.sg/Collection-Landing/listing/1183286"],["WIKI","https://en.wikipedia.org/wiki/Sri_Veeramakaliamman_Temple"]]},
