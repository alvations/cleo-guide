    {"t":2,"a":"SGC","n":"Chinatown Heritage Centre","address":"48 Pagoda Street, Chinatown","k":"Museum","w":"Recreated 1950s shophouse interiors telling the story of Chinatown's early immigrant tenants.","sources":[["ROOTS","https://www.roots.gov.sg/en/places/places-landing/Places/museums/chinatown-heritage-centre"],["CHNC","https://www.chinatownheritagecentre.com.sg/"]]},
