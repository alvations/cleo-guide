{
  "sights": [
    {"t":1,"a":"SGC","n":"Gardens by the Bay","address":"18 Marina Gardens Drive, Marina Bay","k":"Garden","w":"Waterfront nature park with the Supertree Grove, Cloud Forest & Flower Dome; over 1.5 million plants.","sources":[["VISITSG","https://www.visitsingapore.com/see-do-singapore/nature-wildlife/parks-gardens/gardens-by-the-bay/"],["WIKI","https://en.wikipedia.org/wiki/Gardens_by_the_Bay"]]},
    {"t":1,"a":"SGC","n":"Marina Bay Sands SkyPark Observation Deck","address":"10 Bayfront Avenue, Marina Bay","k":"Landmark","w":"The 57th-storey deck atop Marina Bay Sands' three towers, with panoramic skyline views over the bay.","sources":[["MBS","https://www.marinabaysands.com/attractions/sands-skypark.html"],["HONEYCOMBERS","https://honeykidsasia.com/explain-singapores-iconic-unusual-landmarks-marina-bay-sands-esplanade-merlion-artscience-museum/"]]},
    {"t":1,"a":"SGC","n":"Merlion Park","address":"1 Fullerton Road, Marina Bay","k":"Landmark","w":"Home of the 8.6 m Merlion, Singapore's lion-headed, fish-bodied national symbol, spouting into the bay.","sources":[["VISITSG","https://www.visitsingapore.com/see-do-singapore/architecture/modern/merlion-park/"],["WIKI","https://en.wikipedia.org/wiki/Merlion"]]},
    {"t":2,"a":"SGC","n":"ArtScience Museum","address":"6 Bayfront Avenue, Marina Bay","k":"Museum","w":"Lotus-shaped museum at Marina Bay Sands; home to the teamLab 'Future World' digital art gallery.","sources":[["MBS","https://www.marinabaysands.com/museum.html"],["WIKI","https://en.wikipedia.org/wiki/ArtScience_Museum"]]},
    {"t":2,"a":"SGC","n":"Singapore Flyer","address":"30 Raffles Avenue, Marina Bay","k":"Landmark","w":"A 165 m observation wheel over Marina Bay with views to the city, the Straits and beyond.","sources":[["VISITSG","https://www.visitsingapore.com/see-do-singapore/recreation-leisure/viewpoints/singapore-flyer/"],["WIKI","https://en.wikipedia.org/wiki/Singapore_Flyer"]]},
    {"t":1,"a":"SGC","n":"National Gallery Singapore","address":"1 St Andrew's Road, Civic District","k":"Museum","w":"World's largest public collection of Singapore & Southeast Asian art, in the former City Hall & Supreme Court.","sources":[["VISITSG","https://www.visitsingapore.com/neighbourhood/featured-neighbourhood/civic-district/national-gallery-singapore/"],["WIKI","https://en.wikipedia.org/wiki/National_Gallery_Singapore"]]},
    {"t":2,"a":"SGC","n":"National Museum of Singapore","address":"93 Stamford Road, Civic District","k":"Museum","w":"The nation's oldest museum (est. 1849), narrating Singapore's social history.","sources":[["WIKI","https://en.wikipedia.org/wiki/National_Museum_of_Singapore"],["VISITSG","https://www.visitsingapore.com/see-do-singapore/history/museums-monuments/national-museum-of-singapore/"]]},
    {"t":2,"a":"SGC","n":"Asian Civilisations Museum","address":"1 Empress Place, Civic District","k":"Museum","w":"Riverside museum devoted to the material cultures of Asia, from Chinese to West Asian civilisations.","sources":[["WIKI","https://en.wikipedia.org/wiki/Asian_Civilisations_Museum"],["ROOTS","https://www.roots.gov.sg/places/places-landing/Places/national-monuments/empress-place-building"]]},
    {"t":2,"a":"SGC","n":"Raffles Hotel","address":"1 Beach Road, Civic District","k":"Heritage","w":"1887 colonial-era grande dame; a National Monument and birthplace of the Singapore Sling.","sources":[["VISITSG","https://www.visitsingapore.com/see-do-singapore/history/reminiscing/raffles-hotel/"],["WIKI","https://en.wikipedia.org/wiki/Raffles_Hotel"]]},
    {"t":2,"a":"SGC","n":"Fort Canning Park","address":"River Valley Road, Fort Canning","k":"Park","w":"Historic hilltop park with artefacts dating to the 1300s; the famous Fort Canning tree tunnel.","sources":[["NPARKS","https://www.nparks.gov.sg/visit/parks/park-detail/fort-canning-park"],["ROOTS","https://www.roots.gov.sg/places/places-landing/Places/national-monuments/fort-canning"]]},
    {"t":2,"a":"SGC","n":"Esplanade – Theatres on the Bay","address":"1 Esplanade Drive, Marina Bay","k":"Landmark","w":"The 'durian' performing-arts centre on the bayfront, a defining piece of the skyline.","sources":[["WIKI","https://en.wikipedia.org/wiki/Esplanade,_Singapore"],["VISITSG","https://www.visitsingapore.com/see-do-singapore/architecture/modern/esplanade/"]]},
    {"t":1,"a":"SGC","n":"Sri Mariamman Temple","address":"244 South Bridge Road, Chinatown","k":"Temple","w":"Singapore's oldest Hindu temple (1827); a National Monument with a vivid gopuram tower.","sources":[["ROOTS","https://www.roots.gov.sg/places/places-landing/Places/national-monuments/sri-mariamman-temple"],["WIKI","https://en.wikipedia.org/wiki/Sri_Mariamman_Temple,_Singapore"]]},
    {"t":1,"a":"SGC","n":"Buddha Tooth Relic Temple & Museum","address":"288 South Bridge Road, Chinatown","k":"Temple","w":"Tang-style Buddhist temple (2007) housing a sacred tooth relic in a 3,500 kg gold stupa.","sources":[["CHINATOWNSG","https://chinatown.sg/visit/buddha-tooth-relic-temple/"],["NLB","https://www.nlb.gov.sg/main/article-detail?cmsuuid=389e7067-97fb-4e1d-b7e9-688efd442319"]]},
